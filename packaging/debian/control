Depends: ${misc:Depends}, ${python3:Depends}, python3 (>= 3.12),
 ventulusd (>= 3.0.0),
 python3-pyside6.qtcore (>= 6.6), python3-pyside6.qtgui, python3-pyside6.qtwidgets,
 python3-pyside6.qtnetwork, python3-pyside6.qtopengl, python3-pyside6.qtopenglwidgets,
